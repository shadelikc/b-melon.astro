---
import BMFooter from '../components/bmFooter.astro';
import BMHeader from '../components/bmHeader.astro';
import BMBlogPost from '../components/bmBlogPost.astro';
import '../styles/global.css';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "My Astro Learning Blog";
---
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <title>Blog</title>
  </head>
  <body>
    <BMHeader />
    <h1>My Astro Learning Blog</h1>
    <p>This is where I will post about my journey learning Astro.</p>
    <ul>
      {allPosts.map((post: any) => <BMBlogPost url={post.url} title={post.frontmatter.title} />)}
    </ul>
    <BMFooter />
  </body>
</html>